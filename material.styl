            outlineVariant: invoke2(TonalPalette.tone, $core.n2, 30),
            shadow: invoke2(TonalPalette.tone, $core.n1, 0),
            scrim: invoke2(TonalPalette.tone, $core.n1, 0),
            inverseSurface: invoke2(TonalPalette.tone, $core.n1, 90),
