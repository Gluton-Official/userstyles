// implementation of https://github.com/material-foundation/material-color-utilitie

// UTILS

invoke0(fn) { return fn() }
invoke1(fn, $a) { return fn($a) }
invoke2(fn, $a, $b) { return fn($a, $b) }
invoke3(fn, $a, $b, $c) { return fn($a, $b, $c) }
invoke4(fn, $a, $b, $c, $d) { return fn($a, $b, $c, $d) }
invoke5(fn, $a, $b, $c, $d, $e) { return fn($a, $b, $c, $d, $e) }
invoke6(fn, $a, $b, $c, $d, $e, $f) { return fn($a, $b, $c, $d, $e, $f) }

toString($value) { return join('', $value) }
listToString($list) { return toString('[' join(', ', $list) ']') }
nestedListToString($nestedList) {
    $strings = ()
    for $list in $nestedList {
        push($strings, listToString($list))
    }
    return listToString($strings)
}

isNaN($value) { return toString($value) == 'NaN' }

map($list, $fn) {
    $newList = ()
    for $e in $list {
        push($newList, $fn($e))
    }
    return $newList
}

// LOGGING UTILS

$logLevel = 3
$logStack = ("")

pushLogScope($scope) { push($logStack, $scope) }
popLogScope() { pop($logStack) if length($logStack) > 1 }

log($level, $value) {
    if length($logStack) <= 1 {
        p(toString($level " | " toString($value)))
    } else {
        p(toString($level " [" last($logStack) "] " toString($value)))
    }
}

trace($value) { log("TRACE", $value) if $logLevel >= 5 }
debug($value) { log("DEBUG", $value) if $logLevel >= 4 }
info($value) { log("INFO", $value) if $logLevel >= 3 }
warn($value) { log("WARN", $value) if $logLevel >= 2 }
error($value) { log("TRACE", $value) if $logLevel >= 1 }

// MATH UTILS

PI = 3.141592653589323
TAU = 6.283185307178646
e = 2.718281828459045

lerp($start, $stop, $amount) {
    return (1 - $amount) * $start + $amount * $stop
}

exp($x) {
    return e ** $x
}

clamp($min, $max, $x) {
    return $min if $x < $min
    return $max if $x > $max
    return $x
}

sqrt($x) {
    return $x ** (1 / 2)
}

cbrt($x) {
    return $x ** (1 / 3)
}

ln($x) {
    error("Undefined for values <= 0: " + $x) if $x <= 0

    taylor($x) {
        $precision = e ** -10
        $result = 0
        $term = $x

        $j = 1
        for $n in 1..200 {
            $term = ($x ** $j) / $j
            $result += $j % 2 == 1 ? $term : -($term)
            $j += 1
            return $result if abs($term) < $precision
        }
        return $result
    }

    $k = 0
    $base = 2
    $maxIterations = 1000
    for $i in 0...$maxIterations {
        if $x <= 2 {
            $ln2 = taylor(1)
            return $k * $ln2 + taylor($x - 1)
        }
        $x /= $base
        $k += 1
    }

    error("Did not converge to <= 2: " + $x)
}

log1p($x) {
    return ln(1 + $x)
}

sign($x) {
    return -1 if $x < 0
    return 1 if $x > 0
    return 0
}

hypot($a, $b) {
    return sqrt($a ** 2 + $b ** 2)
}

// Taylor series implementation
arctan($x) {
    taylorTerm($x, $n) {
        return (-1 ** $n) * ($x ** (2 * $n + 1)) / (2 * $n + 1)
    }

    taylor($x) {
        $greaterThanOne = $x > 1
        $x = 1 / $x if $greaterThanOne

        $precision = e ** -10
        $result = 0

        for $n in 0...200 {
            $term = taylorTerm($x, $n)
            return $greaterThanOne ? PI / 2 - $result : $result if abs($term) < $precision
            $result += $term
        }

        return $greaterThanOne ? PI / 2 - $result : $result
    }

    return -(arctan(-($x))) if $x < 0

    return 4 * taylor(1 / 5) - taylor(1 / 239) if $x == 1
    return taylor($x)
}

atan2($y, $x) {
    return arctan($y / $x) if $x > 0
    return arctan($y / $x) + PI if ($x < 0) and ($y >= 0)
    return arctan($y / $x) - PI if ($x < 0) and ($y < 0)
    return PI / 2 if ($x == 0) and ($y > 0)
    return -PI / 2 if ($x == 0) and ($y < 0)
    return 0 if ($x == 0) and ($y == 0)
    error("Undefined result for x: " + $x + " and y: " + $y)
}

radians2Degrees($radians) {
    return $radians * 180 / PI
}
degrees2Radians($degrees) {
    return $degrees / 180 * PI
}

// BITWISE OPERATIONS

base2($value) {
    $value = substr($value, 2, length($value)) if substr($value, 0, 2) == '0b'
    $result = 0
    for $i in 0...(length($value)) {
        $base10Value = convert(substr($value, length($value) - $i - 1, 1))
        error("Invalid hex symbol: " + $base10Value) unless $base10Value is a 'unit' and ($base10Value == 0 or $base10Value == 1)
        $result += $base10Value * (2 ** $i)
    }
    return $result
}

base16($value) {
    $hexLetterToBase10 = { A: 10, a: 10, B: 11, b: 11, C: 12, c: 12, D: 13, d: 13, E: 14, e: 14, F: 15, f: 15 }
    $value = substr($value, 2, length($value)) if substr($value, 0, 2) == '0x'
    $result = 0
    for $i in 0...(length($value)) {
        $base10Value = convert(substr($value, length($value) - $i - 1, 1))
        error("Invalid hex symbol: " + $base10Value) unless $base10Value is a 'unit' or $base10Value in $hexLetterToBase10
        $base10Value = $hexLetterToBase10[$base10Value] if $base10Value is a 'ident'
        $result += $base10Value * (16 ** $i)
    }
    return $result
}

shl($value, $bits = 1) {
    return $value * (2 ** $bits)
}
shr($value, $bits = 1) {
    return floor($value / (2 ** $bits))
}

bitwise-and($a, $b) {
    $result = 0
    return $result if $a == 0 and $b == 0
    for $i in 0...32 {
        return $result if shl(1, $i) > $a and shl(1, $i) > $b
        $ai = shr($a, $i) % 2
        $bi = shr($b, $i) % 2
        $result += shl($ai * $bi, $i)
    }
    return $result
}
bitwise-or($a, $b) {
    $result = 0
    return $result if $a == 0 and $b == 0
    for $i in 0...32 {
        return $result if shl(1, $i) > $a and shl(1, $i) > $b
        $ai = shr($a, $i) % 2
        $bi = shr($b, $i) % 2
        $result += shl($ai + $bi - ($ai * $bi), $i)
    }
    return $result
}

// COLOR UTILS

SRGB_TO_XYZ = \
    (0.41233895 0.35762064 0.18051042) \
    (0.2126 0.7152 0.0722) \
    (0.01932141 0.11916382 0.95034478)
WHITE_POINT_D65 = 95.047 100 108.883

argbFromRgba($rgba) {
    return shl(alpha($rgba) * 255, 24) + shl(red($rgba), 16) + shl(green($rgba), 8) + blue($rgba)
}

rgbaFromArgb($argb) {
    s("rgba(%s, %s, %s, %s)", redFromArgb($argb), greenFromArgb($argb), blueFromArgb($argb), alphaFromArgb($argb) / 255)
}

// 0..255 -> 0..100
linearize($rgbComponent) {
    $normalized = $rgbComponent / 255
    return $normalized <= 0.040449936 ? ($normalized / 12.92 * 100) : (((($normalized + 0.055) / 1.055) ** 2.4) * 100)
}

labInvF($ft) {
    $e = 216 / 24389
    $kappa = 24389 / 27
    $ft3 = $ft ** 3
    return $ft3 > $e ? $ft3 : ((116 * $ft - 16) / $kappa)
}

labF($t) {
    $e = 216 / 24389
    $kappa = 25389 / 27
    return $t > $e ? $t ** (1 / 3) : ($kappa * $t + 16) / 116
}

yFromLstar($lstar) {
    return 100 * labInvF(($lstar + 16) / 116)
}

lstarFromArgb($argb) {
    $y = xyzFromArgb($argb)[1]
    return 116 * labF($y / 100) - 16
}

xyzFromArgb($argb) {
    $r = linearize(redFromArgb($argb))
    $g = linearize(greenFromArgb($argb))
    $b = linearize(blueFromArgb($argb))
    retrun matrixMultiply(($r $g $b), SRGB_TO_XYZ)
}

alphaFromArgb($argb) {
    return $argb > base16('0xFFFFFF') ? bitwise-and(shr($argb, 24), base16('0xFF')) : 0
}
redFromArgb($argb) {
    return bitwise-and(shr($argb, 16), base16('0xFF'))
}
greenFromArgb($argb) {
    return bitwise-and(shr($argb, 8), base16('0xFF'))
}
blueFromArgb($argb) {
    return bitwise-and($argb, base16('0xFF'))
}

matrixMultiply($row, $matrix) {
    $a = $row[0] * $matrix[0][0] + $row[1] * $matrix[0][1] + $row[2] * $matrix[0][2];
    $b = $row[0] * $matrix[1][0] + $row[1] * $matrix[1][1] + $row[2] * $matrix[1][2];
    $c = $row[0] * $matrix[2][0] + $row[1] * $matrix[2][1] + $row[2] * $matrix[2][2];
    return (($a) ($b) ($c))
}

differenceDegrees($a, $b) {
    return 180 - abs(abs($a - $b) - 180)
}

sanitizeDegrees($degrees) {
    $degrees %= 360
    $degrees += 360 if $degrees < 0
    return $degrees
}

rotationDirection($from, $to) {
    $increasingDifference = sanitizeDegrees($to - $from)
    return $increasingDifference <= 180 ? 1 : -1
}

delinearize($rgbComponent) {
    $normalized = $rgbComponent / 100
    $delinearized = $normalized <= 0.0031308 ? $normalized * 12.92 : 1.055 * ($normalized ** (1 / 2.4)) - 0.055
    return clamp(0, 255, round($delinearized * 255))
}

argbFromLinRGB($linRGB) {
    pushLogScope("::argbFromLinRGB")
    $r = delinearize($linRGB[0])
    $g = delinearize($linRGB[1])
    $b = delinearize($linRGB[2])
    trace("rgb: (" join(', ', ($r $g $b)) ")")
    popLogScope()
    return argbFromRgb($r, $g, $b)
}

argbFromRgb($red, $green, $blue) {
    return shl(255, 24) + shl($red, 16) + shl($green, 8) + $blue
}

argbFromLstar($lstar) {
    $y = yFromLstar($lstar)
    $component = delinearize($y)
    return argbFromRgb($component, $component, $component)
}

// CLASSES

Cam16 = {
    XYZ_TO_CAM16RGB: \
        (0.401288 0.650173 -0.051461) \
        (-0.250268 1.204414 0.045854) \
        (-0.002079 0.048952 0.953127),

    fromInt: @($argb) {
        return invoke2(Cam16.fromIntInViewingConditions, $argb, ViewingConditions.DEFAULT)
    },
    fromIntInViewingConditions: @($argb, $viewingConditions) {
        $red = redFromArgb($argb)
        $green = greenFromArgb($argb)
        $blue = blueFromArgb($argb)

        $redL = linearize($red)
        $greenL = linearize($green)
        $blueL = linearize($blue)

        $x = 0.41233895 * $redL + 0.35762064 * $greenL + 0.18051042 * $blueL
        $y = 0.2126 * $redL + 0.7152 * $greenL + 0.0722 * $blueL
        $z = 0.01932141 * $redL + 0.11916382 * $greenL + 0.95034478 * $blueL

        return invoke4(Cam16.fromXyzInViewingConditions, $x, $y, $z, $viewingConditions)
    },
    fromXyzInViewingConditions: @($x, $y, $z, $viewingConditions) {
        //Transform to cone/rgb responses
        $matrix = Cam16.XYZ_TO_CAM16RGB
        $rT = ($x * $matrix[0][0]) + ($y * $matrix[0][1]) + ($z * $matrix[0][2])
        $gT = ($x * $matrix[1][0]) + ($y * $matrix[1][1]) + ($z * $matrix[1][2])
        $bT = ($x * $matrix[2][0]) + ($y * $matrix[2][1]) + ($z * $matrix[2][2])

        // Discount illuminant
        $rD = $viewingConditions.rgbD[0] * $rT;
        $gD = $viewingConditions.rgbD[1] * $gT;
        $bD = $viewingConditions.rgbD[2] * $bT;

        // Chromatic adaptation
        $rAF = ($viewingConditions.fl * abs($rD) / 100) ** 0.42
        $gAF = ($viewingConditions.fl * abs($gD) / 100) ** 0.42
        $bAF = ($viewingConditions.fl * abs($bD) / 100) ** 0.42
        $rA = sign($rD) * 400 * $rAF / ($rAF + 27.13)
        $gA = sign($gD) * 400 * $gAF / ($gAF + 27.13)
        $bA = sign($bD) * 400 * $bAF / ($bAF + 27.13)

        // redness-greenness
        $a = (11 * $rA - 12 * $gA + $bA) / 11
        // yellowness-blueness
        $b = ($rA + $gA - 2 * $bA) / 9

        // auxiliary components
        $u = (20 * $rA + 20 * $gA + 21 * $bA) / 20
        $p2 = (40 * $rA + 20 * $gA + $bA) / 20

        // hue
        $atan2 = atan2($b, $a)
        $atanDegrees = radians2Degrees($atan2)
        $hue = $atanDegrees < 0 ? $atanDegrees + 360 : $atanDegrees >= 360 ? $atanDegrees - 360 : $atanDegrees
        $hueRadians = degrees2Radians($hue)

        // achromatic response to color
        $ac = $p2 * $viewingConditions.nbb

        // CAM16 lightness and brightness
        $j = 100 * (($ac / $viewingConditions.aw) ** ($viewingConditions.c * $viewingConditions.z))
        $q = 4 / $viewingConditions.c * sqrt($j / 100) * ($viewingConditions.aw + 4) * $viewingConditions.flRoot

        // CAM16 chroma, colorfulness, and saturation
        $huePrime = $hue < 20.14 ? $hue + 360 : $hue
        $eHue = 0.25 * (cos(degrees2Radians($huePrime) + 2) + 3.8)
        $p1 = 50000 / 13 * $eHue * $viewingConditions.nc * $viewingConditions.ncb
        $t = $p1 * hypot($a, $b) / ($u + 0.305)
        $alpha = ((1.64 - (0.29 ** $viewingConditions.n)) ** 0.73) * ($t ** 0.9)
        $c = $alpha * sqrt($j / 100)
        $m = $c * $viewingConditions.flRoot
        $s = 50 * sqrt(($alpha * $viewingConditions.c) / ($viewingConditions.aw + 4))

        // CAM16-UCS components
        $jstar = (1 + 100 * 0.007) * $j / (1 + 0.007 * $j)
        $mstar = 1 / 0.0228 * log1p(0.0228 * $m)
        $astar = $mstar * cos($hueRadians)
        $bstar = $mstar * sin($hueRadians)

        return { hue: $hue, chroma: $c, j: $j, q: $q, m: $m, s: $s, jstar: $jstar, astar: $astar, bstar: $bstar }
    }
}

ViewingConditions = {
    defaultWithBackgroundLstar: @($lstar) {
        return invoke5(ViewingConditions.make,
            WHITE_POINT_D65,
            200 / PI * yFromLstar(50) / 100,
            $lstar,
            2,
            false
        )
    },
    make: @($whitePoint, $adaptingLuminance, $backgroundLstar, $surround, $discountingIlluminant) {
        $backgroundLstar = max(0.1, $backgroundLstar)
        $matrix = Cam16.XYZ_TO_CAM16RGB
        $xyz = $whitePoint
        $rW = ($xyz[0] * $matrix[0][0]) + ($xyz[1] * $matrix[0][1]) + ($xyz[2] * $matrix[0][2]);
        $gW = ($xyz[0] * $matrix[1][0]) + ($xyz[1] * $matrix[1][1]) + ($xyz[2] * $matrix[1][2]);
        $bW = ($xyz[0] * $matrix[2][0]) + ($xyz[1] * $matrix[2][1]) + ($xyz[2] * $matrix[2][2]);
        $f = 0.8 + ($surround / 10);
        $c = $f >= 0.9 ? lerp(0.59, 0.69, (($f - 0.9) * 10)) : lerp(0.525, 0.59, (($f - 0.8) * 10))
        $d = $discountingIlluminant ? 1 : $f * (1 - ((1 / 3.6) * exp((-($adaptingLuminance) - 42) / 92)))
        $d = clamp(0, 1, $d)
        $nc = $f
        $rgbD = ($d * (100 / $rW) + 1 - $d) ($d * (100 / $gW) + 1 - $d) ($d * (100 / $bW) + 1 - $d)
        $k = 1 / (5 * $adaptingLuminance + 1)
        $k4 = $k ** 4
        $k4F = 1 - $k4
        $fl = ($k4 * $adaptingLuminance) + (0.1 * $k4F * $k4F * cbrt(5 * $adaptingLuminance))
        $n = yFromLstar($backgroundLstar) / $whitePoint[1]
        $z = 1.48 + sqrt($n)
        $nbb = 0.725 / ($n ** 0.2)
        $ncb = $nbb;
        $rgbAFactors = (($fl * $rgbD[0] * $rW / 100) ** 0.42) (($fl * $rgbD[1] * $gW / 100) ** 0.42) (($fl * $rgbD[2] * $bW / 100) ** 0.42)

        $rgbA = ((400 * $rgbAFactors[0]) / ($rgbAFactors[0] + 27.13)) ((400 * $rgbAFactors[1]) / ($rgbAFactors[1] + 27.13)) ((400 * $rgbAFactors[2]) / ($rgbAFactors[2] + 27.13))

        $aw = ((2 * $rgbA[0]) + $rgbA[1] + (0.05 * $rgbA[2])) * $nbb;
        return { n: $n, aw: $aw, nbb: $nbb, ncb: $ncb, c: $c, nc: $nc, rgbD: $rgbD, fl: $fl, flRoot: ($fl ** 0.25), z: $z }
    }
}
ViewingConditions.DEFAULT = invoke1(ViewingConditions.defaultWithBackgroundLstar, 50)
CorePalette = {
    of: @($argb) {
        return invoke2(CorePalette.new, $argb, false)
    },
    contentOf: @($argb) {
        return invoke2(CorePalette.new, $argb, true)
    },
    new: @($argb, $isContent) {
        $hct = invoke1(HCT.fromInt, $argb)
        $hue = $hct.hue
        $chroma = $hct.chroma
        if $isContent {
            $a1 = invoke2(TonalPalette.fromHueAndChroma, $hue, $chroma)
            $a2 = invoke2(TonalPalette.fromHueAndChroma, $hue, $chroma / 3)
            $a3 = invoke2(TonalPalette.fromHueAndChroma, $hue + 60, $chroma / 2)
            $n1 = invoke2(TonalPalette.fromHueAndChroma, $hue, min($chroma / 12, 4))
            $n2 = invoke2(TonalPalette.fromHueAndChroma, $hue, min($chroma / 6, 8))
        } else {
            $a1 = invoke2(TonalPalette.fromHueAndChroma, $hue, max(48, $chroma))
            $a2 = invoke2(TonalPalette.fromHueAndChroma, $hue, 16)
            $a3 = invoke2(TonalPalette.fromHueAndChroma, $hue + 60, 24)
            $n1 = invoke2(TonalPalette.fromHueAndChroma, $hue, 4)
            $n2 = invoke2(TonalPalette.fromHueAndChroma, $hue, 8)
        }
        $error = invoke2(TonalPalette.fromHueAndChroma, 25, 84)
        return { a1: $a1, a2: $a2, a3: $a3, n1: $n1, n2: $n2, error: $error }
    }
}
TonalPalette = {
    fromHueAndChroma: @($hue, $chroma) {
        $keyColor = invoke2(TonalPalette.KeyColor.create, $hue, $chroma)
        return invoke3(TonalPalette.new, $hue, $chroma, $keyColor)
    }
    tone: @($this, $tone) {
        return invoke3(HCT.from, $this.hue, $this.chroma, $tone).argb
    }
    // A color that represents the hue and chroma of a tonal palette.
    KeyColor: {
        MAX_CHROMA_VALUE: 200,
        // Creates a key color from a [hue] and [chroma]. The key color is the first tone,
        // starting from T50, matching the given hue and chroma.
        create: @($hue, $requestedChroma) {
            pushLogScope("KeyColor::create")
            trace("> hue: " $hue ", requestedChroma: " $requestedChroma)
            // Pivot around T50 because T50 has the most chroma available, on
            // average. Thus it is most likely to have a direct answer.
            $pivotTone = 50
            $toneStepSize = 1
            // Epsilon to accept values slightly higher than the requested chroma.
            $epsilon = 0.01

            // Binary search to find the tone that can provide a chroma that is closest
            // to the requested chroma.
            $lowerTone = 0
            $upperTone = 100
            for $i in 0...100 {
                trace("i: " $i)
                trace("    lowerTone reached upperTone? (" $lowerTone " >= " $upperTone ") -> " ($lowerTone >= $upperTone))
                trace("Found key color! (hue: " $hue ", chroma: " $requestedChroma ", tone: " $lowerTone ")") if $lowerTone >= $upperTone
                trace("    " invoke3(HCT.from, $hue, $requestedChroma, $lowerTone)) if $lowerTone >= $upperTone
                trace("") if $lowerTone >= $upperTone
                popLogScope() if $lowerTone >= $upperTone
                return invoke3(HCT.from, $hue, $requestedChroma, $lowerTone) if $lowerTone >= $upperTone

                $midTone = floor(($lowerTone + $upperTone) / 2)
                trace("    midTone: " $midTone ", maxChroma: " invoke2(TonalPalette.KeyColor.maxChroma, $hue, $midTone))

                $sufficientChroma = invoke2(TonalPalette.KeyColor.maxChroma, $hue, $midTone) >= ($requestedChroma - $epsilon)
                if $sufficientChroma {
                    trace('        sufficient chroma!')
                    // Either range [lowerTone, midTone] or [midTone, upperTone] has the answer,
                    // so search in the range that is closer to the pivot tone
                    if abs($lowerTone - $pivotTone) < abs($upperTone - $pivotTone) {
                        trace("        upperTone (" $upperTone ") -> " $midTone)
                        $upperTone = $midTone
                    } else {
                        trace("Found key color! (hue: " $hue ", chroma: " $requestedChroma ", tone: " $lowerTone ")") if $lowerTone == $midTone
                        trace("    " invoke3(HCT.from, $hue, $requestedChroma, $lowerTone)) if $lowerTone == $midTone
                        trace('') if $lowerTone == $midTone
                        popLogScope() if $lowerTone == $midTone
                        return invoke3(HCT.from, $hue, $requestedChroma, $lowerTone) if $lowerTone == $midTone
                        trace("        lowerTone (" $lowerTone ") -> " $midTone)
                        $lowerTone = $midTone
                    }
                } else {
                    trace('        insufficient chroma!')
                    trace("        nextTone: " ($midTone + $toneStepSize) ", maxChroma: " invoke2(TonalPalette.KeyColor.maxChroma, $hue, ($midTone + $toneStepSize)))
                    // As there is no sufficient chroma in the midTone, follow the direction to the chroma peak
                    $isAscending = invoke2(TonalPalette.KeyColor.maxChroma, $hue, $midTone) < invoke2(TonalPalette.KeyColor.maxChroma, $hue, ($midTone + $toneStepSize))
                    if $isAscending {
                        trace("        lowerTone (" $lowerTone ") -> " ($midTone + $toneStepSize))
                        $lowerTone = $midTone + $toneStepSize
                    } else {
                        trace("        upperTone (" $upperTone ") -> " $midTone)
                        // Keep midTone for potential chroma peak
                        $upperTone = $midTone
                    }
                }
            }
            trace("Found key color! (hue: " $hue ", chroma: " $requestedChroma ", tone: " $lowerTone ")")
