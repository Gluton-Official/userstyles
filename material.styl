        }
        return $this
    },
}

themeFromSourceColor($source, $customColors = ()) {
    $palette = invoke1(CorePalette.of, $source)
    $schemes = {
        light: invoke1(Scheme.light, $source),
        dark: invoke1(Scheme.dark, $source),
    }
    $palettes = {
        primary: $palette.a1,
        secondary: $palette.a2,
        tertiary: $palette.a3,
        neutral: $palette.n1,
        neutralVariant: $palette.n2,
        error: $palette.error,
    }
    $customColors = map($customColors, @($c) { customColor($source, $c) })
    return invoke4(Theme.new, $source, $schemes, $palettes, $customColors)
}

customColor($source, $color) {
    $value = $color.value
    $from = clone($value)
    $to = $source
    $value = invoke2(Blend.harmonize, $from, $to) if $color.blend
    $palette = invoke1(CorePalette.of, $value)
    $tones = $palette.a1
    return invoke4(CustomColorGroup.new,
        $color,
        $value,
        /* $light: */ invoke4(ColorGroup.new,
            /* $color: */ invoke1($tones.tone, 40),
            /* $onColor: */ invoke1($tones.tone, 100),
            /* $colorContainer: */ invoke1($tones.tone, 90),
            /* $onColorContainer: */ invoke1($tones.tone, 10)
        ),
        /* $dark: */ invoke4(ColorGroup.new,
            /* $color: */ invoke1($tones.tone, 80),
            /* $onColor: */ invoke1($tones.tone, 20),
            /* $colorContainer: */ invoke1($tones.tone, 30),
            /* $onColorContainer: */ invoke1($tones.tone, 90)
        )
    )
}

CustomColor = {
    new: @($value, $name, $blend) {
        return { value: $value, name: $name, blend: $blend }
    }
}
ColorGroup = {
    new: @($color, $onColor, $colorContainer, $onColorContainer) {
        return { color: $color, onColor: $onColor, colorContainer: $colorContainer, onColorContainer: $onColorContainer }
    }
}
CustomColorGroup = {
    new: @($color, $value, $light, $dark) {
        return { color: $color, value: $value, light: $light, dark: $dark }
    }
}

Blend = {
    harmonize: @($designColor, $sourceColor) {
        $fromHct = invoke1(HCT.fromInt, $designColor)
        $toHct = invoke1(HCT.fromInt, $sourceColor)
        $differenceDegrees = differenceDegrees($fromHct.hue, $toHct.hue)
        $rotationDegrees = min($differenceDegrees * 0.5, 15)
        $outputHue = sanitizeDegrees($fromHct.hue + $rotationDegrees * rotationDirection($fromHct.hue, $toHct.hue))
        return invoke3(HCT.from, $outputHue, $fromHct.chroma, $fromHct.tone).rgba
    }
}

// MAIN

buildPalette($color, $customColors = (), $dark = false, $selector = null) {
    error("Invalid color: " + $color) unless $color is a 'rgba'

    $selector = ":root" if $selector is a 'null'
    $selector = unquote($selector) if $selector is a 'string'

    cv($name, $color) {
        s("    --material-color-%s: %s;", $name, $color)
    }

    $argb = argbFromRgba($color)
    $theme = themeFromSourceColor($argb, $customColors)

    $scheme = $dark ? $theme.schemes.dark : $theme.schemes.light

    s("  %s {", $selector)
    for $name, $argb in $scheme {
        cv(s($name), rgbaFromArgb($argb))
    }
    s("  }")
}