    // Finds an sRGB color with the given hue, chroma, and L*, if possible
    // Returns an sRGB color with sufficiently close hue, chroma, and L* to the desired values, if possible
    // Otherwise, the hue and L* will be sufficient close, and chroma will be maximized
    solveToInt: @($hueDegrees, $chroma, $lstar) {
        pushLogScope("HCTSolver::solveToInt")
        trace("> hueDegrees: " $hueDegrees ", chroma: " $chroma ", tone/lstar: " $lstar)
        popLogScope() if $chroma < 0.0001 or $lstar < 0.0001 or $lstar > 99.9999
        return argbFromLstar($lstar) if $chroma < 0.0001 or $lstar < 0.0001 or $lstar > 99.9999
        $hueDegrees = sanitizeDegrees($hueDegrees)
        trace("sanitized hueDegrees: " $hueDegrees)
        $hueRadians = degrees2Radians($hueDegrees)
        trace("hueRadians: " $hueRadians)
        $y = yFromLstar($lstar)
        trace("y: " $y)
        $exactAnswer = invoke3(HCTSolver.findResultByJ, $hueRadians, $chroma, $y)
        trace("exactAnswer: " $exactAnswer)
        popLogScope() if $exactAnswer != 0
        return $exactAnswer if $exactAnswer != 0
        $linRGB = invoke2(HCTSolver.bisectToLimit, $y, $hueRadians)
        trace("linRGB: " listToString($linRGB))
        trace("rgbaFromLinRGB: " rgbaFromArgb(argbFromLinRGB($linRGB)))
        trace("< " argbFromLinRGB($linRGB))
        popLogScope()
        return argbFromLinRGB($linRGB)
    },
    // Finds a color with the given hue, chroma, and Y
    // Returns the argb color if found, otherwise 0
    findResultByJ: @($hueRadians, $chroma, $y) {
        pushLogScope("HCTSolver::findResultByJ")
        trace("> hueRadians: " $hueRadians ", chroma: " $chroma ", y: " $y)
        // initial estimate of J
        $j = sqrt($y) * 11
        $viewingConditions = ViewingConditions.DEFAULT;
        $tInnerCoeff = 1 / ((1.64 - (0.29 ** $viewingConditions.n)) ** 0.73)
        $eHue = 0.25 * (cos($hueRadians + 2) + 3.8)
        $p1 = $eHue * (50000 / 13) * $viewingConditions.nc * $viewingConditions.ncb;
        $hSin = sin($hueRadians)
        $hCos = cos($hueRadians)
        for $iterationRound in 0...5 {
            $jNormalized = $j / 100
            $alpha = $chroma == 0 or $j == 0 ? 0 : $chroma / sqrt($jNormalized)
            $t = ($alpha * $tInnerCoeff) ** (1 / 0.9)
            $ac = $viewingConditions.aw * ($jNormalized ** (1 / $viewingConditions.c / $viewingConditions.z))
            $p2 = $ac / $viewingConditions.nbb
            $gamma = 23 * ($p2 + 0.305) * $t / (23 * $p1 + 11 * $t * $hCos + 108 * $t * $hSin)
            $a = $gamma * $hCos
            $b = $gamma * $hSin
            $rA = (460 * $p2 + 451 * $a + 288 * $b) / 1403
            $gA = (460 * $p2 - 891 * $a - 261 * $b) / 1403
            $bA = (460 * $p2 - 220 * $a - 6300 * $b) / 1403
            $rCScaled = invoke1(HCTSolver.inverseChromaticAdaptation, $rA)
            $gCScaled = invoke1(HCTSolver.inverseChromaticAdaptation, $gA)
            $bCScaled = invoke1(HCTSolver.inverseChromaticAdaptation, $bA)
            trace("rgbCScaled: " listToString(($rCScaled $gCScaled $bCScaled)))
            trace("LINRGB_FROM_SCALED_DISCOUNT: " nestedListToString(HCTSolver.LINRGB_FROM_SCALED_DISCOUNT))
            $linRGB = matrixMultiply(($rCScaled $gCScaled $bCScaled), HCTSolver.LINRGB_FROM_SCALED_DISCOUNT)
            trace("linRGB: " listToString($linRGB))

            trace("< 0") if $linRGB[0] < 0 or $linRGB[1] < 0 or $linRGB[2] < 0
            popLogScope() if $linRGB[0] < 0 or $linRGB[1] < 0 or $linRGB[2] < 0
            return 0 if $linRGB[0] < 0 or $linRGB[1] < 0 or $linRGB[2] < 0
            $kR = HCTSolver.Y_FROM_LINRGB[0]
            $kG = HCTSolver.Y_FROM_LINRGB[1]
            $kB = HCTSolver.Y_FROM_LINRGB[2]
            $fnj = $kR * $linRGB[0] + $kG * $linRGB[1] + $kB * $linRGB[2]
            trace("< 0") if $fnj <= 0
            popLogScope() if $fnj <= 0
            return 0 if $fnj <= 0
            if $iterationRound == 4 or abs($fnj - $y) < 0.002 {
                trace("< 0") if $linRGB[0] > 100.01 or $linRGB[1] > 100.01 or $linRGB[2] > 100.01
                popLogScope() if $linRGB[0] > 100.01 or $linRGB[1] > 100.01 or $linRGB[2] > 100.01
                return 0 if $linRGB[0] > 100.01 or $linRGB[1] > 100.01 or $linRGB[2] > 100.01
                trace("< " argbFromLinRGB($linRGB))
                popLogScope()
                return argbFromLinRGB($linRGB)
            }
            // Iterates with Newton method,
            // Using 2 * fn(j) / j as the approximation of fn'(j)
            $j = $j - ($fnj - $y) * $j / (2 * $fnj)
        }
        trace("< 0")
        popLogScope()
        return 0
    },
    chromaticAdaptation: @($component) {
        $af = abs($component) ** 0.42
        return sign($component) * 400 * $af / ($af + 27.13)
    },
    inverseChromaticAdaptation: @($adapted) {
        $adaptedAbs = abs($adapted)
        $base = max(0, 27.13 * $adaptedAbs / (400 - $adaptedAbs))
        return sign($adapted) * ($base ** (1 / 0.42))
    },
    // Finds a color with the Given Y and hue on the boundary of the cube
    // Returns the desired color, in linear RGB coordinates
    bisectToLimit: @($y, $targetHue) {
        pushLogScope("HCTSolver::bisectToLimit")
        trace("> y: " $y ", targetHue: " $targetHue)
        $segment = invoke2(HCTSolver.bisectToSegment, $y, $targetHue)
        trace("segment: " nestedListToString($segment))
        $left = $segment[0]
        trace("left: " listToString($left))
        $leftHue = invoke1(HCTSolver.hueOf, $left)
        trace("leftHue: " $leftHue)
        $right = $segment[1]
        trace("right: " listToString($right))
        for $axis in 0...3 {
            trace("left[" $axis "]: " $left[$axis])
            trace("right[" $axis "]: " $right[$axis])
            if $left[$axis] != $right[$axis] {
                $lPlane = -1
                $rPlane = 255
                if $left[$axis] < $right[$axis] {
                    $lPlane = invoke1(HCTSolver.criticalPlaneBelow, invoke1(HCTSolver.trueDelinearize, $left[$axis]))
                    $rPlane = invoke1(HCTSolver.criticalPlaneAbove, invoke1(HCTSolver.trueDelinearize, $right[$axis]))
                } else {
                    $lPlane = invoke1(HCTSolver.criticalPlaneAbove, invoke1(HCTSolver.trueDelinearize, $left[$axis]))
                    $rPlane = invoke1(HCTSolver.criticalPlaneBelow, invoke1(HCTSolver.trueDelinearize, $right[$axis]))
                }
                trace("lPlane: " $lPlane)
                trace("rPlane: " $rPlane)
                for $i in 0...8 {
                    if abs($rPlane - $lPlane) > 1 {
                        $mPlane = floor(($lPlane + $rPlane) / 2)
                        trace("mPlane: " $mPlane)
                        $midPlaneCoordinate = HCTSolver.CRITICAL_PLANES[$mPlane]
                        trace("midPlaneCoordinate: " $midPlaneCoordinate)
                        $mid = invoke4(HCTSolver.setCoordinate, $left, $midPlaneCoordinate, $right, $axis)
                        trace("mid: " listToString($mid))
                        $midHue = invoke1(HCTSolver.hueOf, $mid)
                        trace("midHue: " $midHue)
                        if invoke3(HCTSolver.areInCyclicOrder, $leftHue, $targetHue, $midHue) {
                            $right = $mid
                            $rPlane = $mPlane
                        } else {
                            $left = $mid
                            $leftHue = $midHue
                            $lPlane = $mPlane
                        }
                    }
                }
            }
        }
        trace("< " listToString(invoke2(HCTSolver.midpoint, $left, $right)))
        popLogScope()
        return invoke2(HCTSolver.midpoint, $left, $right)
    },
    // Finds the segment containing the desired color
    // Returns a list of two sets of linear RGB coordinates, each corresponding to
    // an endpoint of the segment containing the desired color
    bisectToSegment: @($y, $targetHue) {
        pushLogScope("HCTSolver::bisectToSegment")
        trace("> y: " $y ", targetHue: " $targetHue)
        $left = ((-1) (-1) (-1))
        $right = $left
        $leftHue = 0
        $rightHue = 0
        $initialized = false
        $uncut = true
        for $n in 0...12 {
            trace("n: " $n)
            trace("left: " listToString($left))
            trace("right: " listToString($right))
            trace("leftHue: " $leftHue)
            trace("rightHue: " $rightHue)
            trace("initialized: " $initialized)
            trace("uncut: " $uncut)
            $mid = invoke2(HCTSolver.nthVertex, $y, $n)
            trace("mid: " listToString($mid))
            if $mid[0] >= 0 {
                $midHue = invoke1(HCTSolver.hueOf, $mid)
                trace("midHue: " $midHue)
                if !$initialized {
                    $left = $mid
                    $right = $mid
                    $leftHue = $midHue
                    $rightHue = $midHue
                    $initialized = true
                } else if $uncut or invoke3(HCTSolver.areInCyclicOrder, $leftHue, $midHue, $rightHue) {
                    $uncut = false
                    if invoke3(HCTSolver.areInCyclicOrder, $leftHue, $targetHue, $midHue) {
                        $right = $mid
                        $rightHue = $midHue
                    } else {
                        $left = $mid
                        $leftHue = $midHue
                    }
                }
            }
        }
        trace("< " nestedListToString(($left $right)))
        popLogScope()
        return ($left $right)
    },
    hueOf: @($linRGB) {
        pushLogScope("HCTSolver::hueOf")
        trace("> " listToString($linRGB))
        $scaledDiscount = matrixMultiply($linRGB, HCTSolver.SCALED_DISCOUNT_FROM_LINRGB)
        $rA = invoke1(HCTSolver.chromaticAdaptation, $scaledDiscount[0])
        $gA = invoke1(HCTSolver.chromaticAdaptation, $scaledDiscount[1])
        $bA = invoke1(HCTSolver.chromaticAdaptation, $scaledDiscount[2])
        // redness-greenness
        $a = (11 * $rA + (-12 * $gA) + $bA) / 11
        // yellowness-blueness
        $b = ($rA + $gA - 2 * $bA) / 9
        trace("< " atan2($b, $a))
        popLogScope()
        return atan2($b, $a)
    },
    areInCyclicOrder: @($a, $b, $c) {
        pushLogScope("HCTSolver::areInCyclicOrder")
        trace("> a: " $a ", b: " $b ", c: " $c)
        $deltaAB = invoke1(HCTSolver.sanitizeRadians, $b - $a)
        trace("deltaAB: " $deltaAB)
        $deltaAC = invoke1(HCTSolver.sanitizeRadians, $c - $a)
        trace("deltaAC: " $deltaAC)
        trace("< " ($deltaAB < $deltaAC))
        popLogScope()
        return $deltaAB < $deltaAC
    },
    sanitizeRadians: @($angle) {
        $dividend = $angle + PI * 8
        return $dividend % TAU
    },
    trueDelinearize: @($rgbComponent) {
        pushLogScope("HCTSolver::trueDelinearize")
        trace("> rgbComponent: " $rgbComponent)
        $normalized = $rgbComponent / 100
        $delinearized = $normalized <= 0.0031308 ? $normalized * 12.92 : 1.055 * ($normalized ** (1 / 2.4)) - 0.055
        trace("< " ($delinearized * 255))
        popLogScope()
        return $delinearized * 255
    },
    nthVertex: @($y, $n) {
        $kR = HCTSolver.Y_FROM_LINRGB[0]
        $kG = HCTSolver.Y_FROM_LINRGB[1]
        $kB = HCTSolver.Y_FROM_LINRGB[2]
        $coordA = $n % 4 <= 1 ? 0 : 100
        $coordB = $n % 2 == 0 ? 0 : 100
        if $n < 4 {
            $g = $coordA
            $b = $coordB
            $r = ($y - $g * $kG - $b * $kB) / $kR
            return invoke1(HCTSolver.isBounded, $r) ? ($r $g $b) : ((-1) (-1) (-1))
        } else if $n < 8 {
            $b = $coordA
            $r = $coordB
            $g = ($y - $r * $kR - $b * $kB) / $kG
            return invoke1(HCTSolver.isBounded, $g) ? ($r $g $b) : ((-1) (-1) (-1))
        } else {
            $r = $coordA
            $g = $coordB
            $b = ($y - $r * $kR - $g * $kG) / $kB
            return invoke1(HCTSolver.isBounded, $b) ? ($r $g $b) : ((-1) (-1) (-1))
        }
    },
    criticalPlaneBelow: @($x) {
        return floor($x - 0.5)
    },
    criticalPlaneAbove: @($x) {
        return ceil($x - 0.5)
    },
    midpoint: @($a, $b) {
        return (($a[0] + $b[0]) / 2) (($a[1] + $b[1]) / 2) (($a[2] + $b[2]) / 2)
    },
    setCoordinate: @($source, $coordinate, $target, $axis) {
        $t = invoke3(HCTSolver.intercept, $source[$axis], $coordinate, $target[$axis])
        return invoke3(HCTSolver.lerpPoint, $source, $t, $target)
    },
    isBounded: @($x) {
        return 0 <= $x and $x <= 100
    },
    intercept: @($source, $mid, $target) {
        return ($mid - $source) / ($target - $source)
    },
    lerpPoint: @($source, $t, $target) {
        return \
            ($source[0] + ($target[0] - $source[0]) * $t) \
            ($source[1] + ($target[1] - $source[1]) * $t) \
            ($source[2] + ($target[2] - $source[2]) * $t)
    }
}

Theme = {
    new: @($source, $schemes, $palettes, $customColors) {
        $this = {
            source: $source,
            schemes: $schemes,
            palettes: $palettes,
            customColors: $customColors
        }
        return $this
    }
}

Scheme = {
    light: @($argb) {
        return invoke1(Scheme.lightFromCorePalette, invoke1(CorePalette.of, $argb))
    },
    dark: @($argb) {
        return invoke1(Scheme.darkFromCorePalette, invoke1(CorePalette.of, $argb))
    },
    lightContent: @($argb) {
        return invoke1(Scheme.lightFromCorePalette, invoke1(CorePalette.contentOf, $argb))
    },
    darkContent: @($argb) {
