    },
    lightFromCorePalette: @($core) {
        $this = {
            primary: invoke2(TonalPalette.tone, $core.a1, 40),
            onPrimary: invoke2(TonalPalette.tone, $core.a1, 100),
            primaryContainer: invoke2(TonalPalette.tone, $core.a1, 90),
            onPrimaryContainer: invoke2(TonalPalette.tone, $core.a1, 10),
            secondary: invoke2(TonalPalette.tone, $core.a2, 40),
            onSecondary: invoke2(TonalPalette.tone, $core.a2, 100),
            secondaryContainer: invoke2(TonalPalette.tone, $core.a2, 90),
            onSecondaryContainer: invoke2(TonalPalette.tone, $core.a2, 10),
            tertiary: invoke2(TonalPalette.tone, $core.a3, 40),
            onTertiary: invoke2(TonalPalette.tone, $core.a3, 100),
            tertiaryContainer: invoke2(TonalPalette.tone, $core.a3, 90),
            onTertiaryContainer: invoke2(TonalPalette.tone, $core.a3, 10),
            error: invoke2(TonalPalette.tone, $core.error, 40),
            onError: invoke2(TonalPalette.tone, $core.error, 100),
            errorContainer: invoke2(TonalPalette.tone, $core.error, 90),
            onErrorContainer: invoke2(TonalPalette.tone, $core.error, 10),
            background: invoke2(TonalPalette.tone, $core.n1, 99),
            onBackground: invoke2(TonalPalette.tone, $core.n1, 10),
            surface: invoke2(TonalPalette.tone, $core.n1, 99),
            onSurface: invoke2(TonalPalette.tone, $core.n1, 10),
            surfaceVariant: invoke2(TonalPalette.tone, $core.n2, 90),
            onSurfaceVariant: invoke2(TonalPalette.tone, $core.n2, 30),
            outline: invoke2(TonalPalette.tone, $core.n2, 50),
            outlineVariant: invoke2(TonalPalette.tone, $core.n2, 80),
            shadow: invoke2(TonalPalette.tone, $core.n1, 0),
            scrim: invoke2(TonalPalette.tone, $core.n1, 0),
            inverseSurface: invoke2(TonalPalette.tone, $core.n1, 20),
            inverseOnSurface: invoke2(TonalPalette.tone, $core.n1, 95),
            inversePrimary: invoke2(TonalPalette.tone, $core.a1, 80),
        }
        return $this
    },
    darkFromCorePalette: @($core) {
        $this = {
            primary: invoke2(TonalPalette.tone, $core.a1, 80),
            onPrimary: invoke2(TonalPalette.tone, $core.a1, 20),
            primaryContainer: invoke2(TonalPalette.tone, $core.a1, 30),
            onPrimaryContainer: invoke2(TonalPalette.tone, $core.a1, 90),
            secondary: invoke2(TonalPalette.tone, $core.a2, 80),
            onSecondary: invoke2(TonalPalette.tone, $core.a2, 20),
            secondaryContainer: invoke2(TonalPalette.tone, $core.a2, 30),
            onSecondaryContainer: invoke2(TonalPalette.tone, $core.a2, 90),
            tertiary: invoke2(TonalPalette.tone, $core.a3, 80),
            onTertiary: invoke2(TonalPalette.tone, $core.a3, 20),
            tertiaryContainer: invoke2(TonalPalette.tone, $core.a3, 30),
            onTertiaryContainer: invoke2(TonalPalette.tone, $core.a3, 90),
            error: invoke2(TonalPalette.tone, $core.error, 80),
            onError: invoke2(TonalPalette.tone, $core.error, 30),
            errorContainer: invoke2(TonalPalette.tone, $core.error, 30),
            onErrorContainer: invoke2(TonalPalette.tone, $core.error, 80),
            background: invoke2(TonalPalette.tone, $core.n1, 10),
            onBackground: invoke2(TonalPalette.tone, $core.n1, 90),
            surface: invoke2(TonalPalette.tone, $core.n1, 10),
            onSurface: invoke2(TonalPalette.tone, $core.n1, 90),
            surfaceVariant: invoke2(TonalPalette.tone, $core.n2, 30),
            onSurfaceVariant: invoke2(TonalPalette.tone, $core.n2, 80),
